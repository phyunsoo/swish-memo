DEFINE SCHEMA

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy" REFERENCE,
        "___etag" STRING,
        "___modTime" TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID" REFERENCE,
        roles LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );

    // App records are private-database only; no public-database grants.
    RECORD TYPE SwishMemoNote (
        "___recordID" REFERENCE QUERYABLE,
        payload STRING,
        modifiedAt TIMESTAMP,
        photoAssets LIST<ASSET>
    );

    RECORD TYPE SwishMemoFolder (
        "___recordID" REFERENCE QUERYABLE,
        payload STRING,
        modifiedAt TIMESTAMP
    );

    RECORD TYPE SwishMemoTombstone (
        "___recordID" REFERENCE QUERYABLE,
        payload STRING,
        modifiedAt TIMESTAMP
    );
