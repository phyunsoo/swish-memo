{
  "expo": {
    "name": "swish",
    "slug": "swish-memo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/swish-icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/swish-icon.png",
      "bundleIdentifier": "com.phyunsoo.swishmemo",
      "appleTeamId": "87A9TG46YC",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "icon": "./assets/images/swish-icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/swish-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "메모에 첨부할 사진을 선택합니다.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "./plugins/with-todo-widget"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "SwishTodoWidget",
                  "bundleIdentifier": "com.phyunsoo.swishmemo.todo-widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.phyunsoo.swishmemo"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "8f1e9931-ff04-49c6-a1d4-43e480bf1338"
      }
    },
    "owner": "phyunsoo"
  }
}
