{
  "expo": {
    "name": "swish 메모",
    "slug": "swish-memo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.phyunsoo.swishmemo",
      "appleTeamId": "87A9TG46YC",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "./plugins/with-todo-widget"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "SwishTodoWidget",
                  "bundleIdentifier": "com.phyunsoo.swishmemo.todo-widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.phyunsoo.swishmemo"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "8f1e9931-ff04-49c6-a1d4-43e480bf1338"
      }
    },
    "owner": "phyunsoo"
  }
}
