# macOS
.DS_Store

# Dependencies and build output
my-app/node_modules/
my-app/.expo/
my-app/dist/
my-app/web-build/
my-app/ios/
my-app/android/

# Expo and Metro generated files
my-app/expo-env.d.ts
my-app/.metro-health-check*

# Local environment and debug files
my-app/.env*.local
my-app/npm-debug.*
my-app/yarn-debug.*
my-app/yarn-error.*
